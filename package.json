{
  "name": "markus-the-editor",
  "version": "0.11.1",
  "description": "A local WYSIWYG Markdown editor built with Electron, React, and ProseMirror",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Tom Himanen",
    "email": "tom.himanen@futuhima.ninja"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node packages/markus-server/scripts/build-server.mjs && vite",
    "build": "node packages/markus-server/scripts/build-server.mjs && tsc && vite build",
    "electron": "electron .",
    "dev:full": "node packages/markus-server/scripts/build-server.mjs && rm -f dist-electron/main.js dist-electron/preload.js && concurrently -k \"vite\" \"wait-on http://localhost:5183 && wait-on dist-electron/main.js && sleep 3 && VITE_DEV_SERVER_URL=http://localhost:5183 MARKUS_PORT=3848 electron .\"",
    "dist": "npm run build && electron-builder --publish=never",
    "lint": "eslint src electron --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.63",
    "@monaco-editor/react": "^4.7.0",
    "@napi-rs/canvas": "^0.1.94",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-menubar": "^1.0.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.5.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^0.2.0",
    "defuddle": "^0.8.0",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "fastest-levenshtein": "^1.0.16",
    "html-to-docx": "^1.8.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.309.0",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.0.0",
    "mermaid": "^11.12.2",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "path-browserify": "^1.0.1",
    "pdfjs-dist": "^5.4.624",
    "prosemirror-commands": "^1.5.2",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.3.2",
    "prosemirror-inputrules": "^1.3.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-markdown": "^1.12.0",
    "prosemirror-model": "^1.19.4",
    "prosemirror-schema-list": "^1.3.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.32.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-json-tree": "^0.18.0",
    "simple-git": "^3.22.0",
    "tailwind-merge": "^2.2.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "uuid": "^13.0.0",
    "word-extractor": "^1.0.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^13.0.7",
    "@types/node": "^20.10.6",
    "@types/path-browserify": "^1.0.3",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.1.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.markus.editor",
    "productName": "Markus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/terminal/vcat",
        "to": "vcat"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@napi-rs/canvas/**"
    ],
    "icon": "resources/icons/icon.png",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "category": "Utility",
      "icon": "resources/icons",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown",
        "text/mdx"
      ],
      "desktop": {
        "Name": "Markus",
        "Comment": "WYSIWYG Markdown editor",
        "MimeType": "text/markdown;text/x-markdown;text/mdx;"
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icons/icon.png",
      "artifactName": "${productName}-${version}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdx"
          ],
          "name": "Markdown Document",
          "role": "Editor",
          "mimeType": "text/markdown"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icons/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdx"
          ],
          "name": "Markdown Document",
          "description": "Markdown Document",
          "icon": "resources/icons/icon.ico"
        }
      ]
    }
  }
}
