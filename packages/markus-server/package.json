{
  "name": "@markus/server",
  "version": "0.1.0",
  "description": "Standalone API server for Markus AI agent",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "markus-server": "./bin/markus-server.js"
  },
  "scripts": {
    "build:core": "node scripts/build-core.mjs",
    "dev": "npm run build:core && cd ../.. && npx tsx packages/markus-server/src/index.ts",
    "start": "npm run build:core && cd ../.. && npx tsx packages/markus-server/src/index.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.20.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "fastest-levenshtein": "^1.0.16"
  }
}
